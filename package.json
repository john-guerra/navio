{
  "name": "navio",
  "version": "0.0.75",
  "description": "A visualization widget for summarizing and exploring data",
  "type": "module",
  "main": "dist/navio.min.js",
  "module": "dist/navio.esm.js",
  "browser": "dist/navio.min.js",
  "unpkg": "dist/navio.min.js",
  "jsdelivr": "dist/navio.min.js",
  "dependencies": {
    "d3": "^7.8.5",
    "popper.js": "^1.16.1",
    "reactive-widget-helper": "^0.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-node-resolve": "^15.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.8.0",
    "http-server": "^14.1.1",
    "prettier": "^3.9.6",
    "rollup": "^3.25.1",
    "rollup-plugin-commonjs": "^10.1.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "postbuild": "node build/verify-bundle.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-guerra/navio.git"
  },
  "keywords": [
    "DataViz",
    "Data exploration"
  ],
  "author": {
    "name": "John Alexis Guerra Gómez",
    "url": "https://johnguerra.co"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/john-guerra/Navio/issues"
  },
  "homepage": "https://navio.dev"
}
